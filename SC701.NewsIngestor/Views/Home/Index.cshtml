@model IEnumerable<SC701.Models.SourceItem>
@using System.Text.Json
@using SC701.Models.DTOs

@{
    ViewData["Title"] = "Inicio";
    var sources = ViewBag.Sources as List<SC701.Models.Source>;

    StandardNewsItemDto? ParseJson(string json)
    {
        try { return JsonSerializer.Deserialize<StandardNewsItemDto>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }); }
        catch { return null; }
    }
}

@* HERO SECTION *@
<div class="hero-section fade-in mb-5">
    <div class="container text-center py-5">
        <h1 class="hero-title fw-bold">SC701-NewsIngestor</h1>
        <p class="hero-subtitle text-muted">Contenido normalizado desde múltiples fuentes externas.</p>
    </div>
</div>

<div class="container-fluid px-4">

    @* --- SECCIÓN 1: NOTICIAS GUARDADAS --- *@
    <div class="d-flex align-items-center justify-content-between mb-4 fade-in">
        <div>
            <h2 class="fw-bold mb-0">📁 Noticias Guardadas</h2>
            <p class="text-muted">Almacenadas permanentemente en el sistema.</p>
        </div>
        <a asp-controller="Items" asp-action="Index" class="btn btn-primary-custom btn-sm">Ver historial completo</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5 fade-in">
            @foreach (var item in Model)
            {
                var dto = ParseJson(item.Json);
                <div class="col">
                    <div class="card h-100 news-card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary-subtle text-primary">💾 Guardado</span>
                                <small class="text-muted">@item.Source?.Name</small>
                            </div>
                            <h5 class="card-title fw-bold">@(dto?.Normalized?.Title ?? "Sin Título")</h5>
                            <p class="card-text text-muted small">@(dto?.Normalized?.Summary ?? "Sin resumen...")</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 small text-muted">
                            📅 @item.CreatedAt.ToString("dd MMM, yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border mb-5 text-center text-muted fade-in">
            📭 No hay noticias guardadas aún. Guardá algunas desde <a asp-controller="Sources" asp-action="Index">Fuentes</a>.
        </div>
    }

    <div class="my-5"></div>

    @* --- SECCIÓN 2: NOTICIAS EN VIVO (POR FUENTE) --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 fade-in">
        <h2 class="h4 mb-0 fw-bold">📡 Noticias en Vivo</h2>
        <a asp-controller="Sources" asp-action="Index" class="btn btn-sm btn-outline-secondary shadow-sm">Gestionar Fuentes</a>
    </div>

    <div class="row g-4 mb-5">
        @if (sources != null && sources.Any())
        {
            @foreach (var source in sources)
            {
                <div class="col-12 fade-in">
                    <div class="feature-card-news shadow-sm border rounded-4 bg-white overflow-hidden">

                        @* Cabecera de la Fuente *@
                        <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div class="feature-icon-small @(source.ComponentType?.ToUpper() == "RSS" ? "primary" : source.ComponentType?.ToUpper() == "API" ? "success" : "warning")">
                                    @(source.ComponentType?.ToUpper() == "RSS" ? "📰" : source.ComponentType?.ToUpper() == "API" ? "🔌" : "🕷️")
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold text-dark" style="font-size: 1.1rem;">@source.Name</h5>
                                    <small class="text-muted text-truncate d-block" style="max-width: 300px;">@source.Url</small>
                                </div>
                            </div>
                            <span class="badge bg-white text-dark border shadow-sm">@source.ComponentType</span>
                        </div>

                        @* Cuerpo: el JS inyecta la noticia aquí *@
                        <div class="news-live-body" id="feed-@source.Id" data-source-id="@source.Id">
                            <div class="text-center py-5">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span class="ms-2 text-muted">Sincronizando noticia...</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border text-center text-muted">
                    📭 No hay fuentes configuradas. <a asp-controller="Sources" asp-action="Create">Agregá una</a>.
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const containers = document.querySelectorAll('.news-live-body');
            containers.forEach(container => {
                const id = container.getAttribute('data-source-id');
                fetchLiveNews(id, container);
            });
        });

        async function fetchLiveNews(id, container) {
            try {
                const response = await fetch(`/api/SourcesApi/${id}/preview`, { credentials: 'include' });
                const data = await response.json();

                if (!response.ok || !data.items?.length) {
                    container.innerHTML = `<div class="p-4 text-muted small text-center">No hay noticias disponibles actualmente.</div>`;
                    return;
                }

                const item = data.items[0];
                const imgUrl = item.imageUrl || item.ImageUrl;

                container.innerHTML = `
                    <div class="p-4">
                        <div class="row g-4 align-items-center">
                            <div class="col-md-3">
                                <div class="news-img-container">
                                    ${imgUrl
                                        ? `<img src="${imgUrl}" class="img-fluid rounded-3 border" onerror="this.parentElement.innerHTML='<div class=\\'news-img-placeholder\\'>📷</div>'">`
                                        : `<div class="news-img-placeholder">📷</div>`}
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <h4 class="h5 fw-bold mb-0 text-dark">${escHtml(item.title || item.Title)}</h4>
                                    <button class="btn btn-save-pill"
                                            onclick="saveItem(${id}, 0, this)"
                                            data-raw='${escAttr(item.rawJson || item.RawJson)}'>
                                        💾 Guardar
                                    </button>
                                </div>
                                <div class="d-flex gap-3 mb-3 text-muted" style="font-size: 0.8rem;">
                                    <span>📅 ${new Date(item.publishedAt || item.PublishedAt).toLocaleDateString()}</span>
                                    <a href="${item.articleUrl || item.ArticleUrl}" target="_blank" class="text-primary text-decoration-none fw-bold">🔗 Ver original</a>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 0.9rem; line-height: 1.6;">
                                    ${escHtml(item.summary || item.Summary || "Sin descripción disponible.")}
                                </p>
                            </div>
                        </div>
                    </div>
                `;
            } catch (err) {
                container.innerHTML = `<div class="p-4 text-danger small text-center">Error de conexión.</div>`;
            }
        }

        async function saveItem(sourceId, index, btn) {
            const rawJson = btn.getAttribute('data-raw');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            try {
                const res = await fetch(`/api/SourcesApi/${sourceId}/save-item`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ rawJson })
                });

                if (res.ok || res.status === 201) {
                    btn.innerHTML = '✅ Guardado';
                    btn.className = 'btn btn-success-pill';
                } else if (res.status === 409) {
                    btn.innerHTML = '⚠️ Existe';
                } else {
                    btn.innerHTML = '❌ Error';
                    btn.disabled = false;
                    setTimeout(() => { btn.innerHTML = originalContent; }, 2000);
                }
            } catch (err) {
                btn.innerHTML = '❌ Error';
                btn.disabled = false;
            }
        }

        function escHtml(s) { if (!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
        function escAttr(s) { if (!s) return ''; return String(s).replace(/'/g,'&apos;').replace(/"/g,'&quot;'); }
    </script>
}

@section Styles {
    <style>
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .feature-card-news {
            transition: all 0.3s ease;
            border: 1px solid #eef2f6 !important;
        }
        .feature-card-news:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

        .feature-icon-small {
            width: 40px; height: 40px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 10px; font-size: 1.1rem;
        }
        .feature-icon-small.primary { background: #e0f2fe; color: #0369a1; }
        .feature-icon-small.success { background: #dcfce7; color: #15803d; }
        .feature-icon-small.warning { background: #fef3c7; color: #b45309; }

        .news-img-container img {
            width: 100%; height: 140px; object-fit: cover;
        }
        .news-img-placeholder {
            height: 140px; background: #f8fafc;
            display: flex; align-items: center; justify-content: center;
            border-radius: 8px; color: #cbd5e1; font-size: 2rem;
            border: 1px dashed #e2e8f0;
        }

        .btn-save-pill {
            background: #fff; border: 1px solid #e2e8f0; color: #475569;
            border-radius: 50px; padding: 0.4rem 1.2rem;
            font-size: 0.85rem; font-weight: 700; transition: all 0.2s;
        }
        .btn-save-pill:hover { background: #f8fafc; border-color: #cbd5e1; }

        .btn-success-pill {
            background: #dcfce7; color: #166534; border: 1px solid #bbf7d0;
            border-radius: 50px; padding: 0.4rem 1.2rem;
            font-size: 0.85rem; font-weight: 700;
        }

        .news-card {
            transition: all 0.2s ease; border-radius: 12px;
        }
        .news-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1) !important;
        }
    </style>
}
