@model IEnumerable<SC701.Models.Source>
@{
    ViewData["Title"] = "Fuentes";
}

<div class="page-header">
    <div>
        <h1 class="page-title">📡 Fuentes</h1>
        <p class="text-muted mb-0" style="font-size:0.9rem;">
            Configurá las fuentes y jalá noticias en vivo
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge badge-primary-custom" style="font-size:1rem; padding:0.6rem 1.2rem;">
            @Model.Count() fuente(s)
        </span>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-custom">➕ Nueva Fuente</a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div class="card-custom" style="max-width:600px; margin:0 auto;">
            <div class="card-body p-5">
                <div style="font-size:4rem; margin-bottom:1rem;">📭</div>
                <h3 class="mb-3">No hay fuentes registradas</h3>
                <p class="text-muted mb-4">
                    Agregá una fuente RSS, NewsAPI o JSON para empezar a ingestar noticias.
                </p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-primary-custom">➕ Crear Primera Fuente</a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="table-custom">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:5%">ID</th>
                    <th style="width:20%">Nombre</th>
                    <th style="width:25%">URL</th>
                    <th style="width:10%">Tipo</th>
                    <th style="width:8%">Secret</th>
                    <th style="width:7%">Items</th>
                    <th style="width:25%">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var source in Model)
                {
                    <tr class="hover-lift">
                        <td><strong style="color:var(--primary);">#@source.Id</strong></td>
                        <td><strong>@source.Name</strong></td>
                        <td>
                            <a href="@source.Url" target="_blank" class="text-decoration-none"
                               style="color:var(--gray-600); font-size:0.85rem;" title="@source.Url">
                                @(source.Url.Length > 38 ? source.Url[..38] + "…" : source.Url)
                            </a>
                        </td>
                        <td>
                            <span class="badge badge-primary-custom" style="font-size:0.75rem;">
                                @source.ComponentType
                            </span>
                        </td>
                        <td>
                            @if (source.RequiresSecret)
                            {
                                <span class="badge badge-warning-custom" style="font-size:0.75rem;">🔐 Sí</span>
                            }
                            else
                            {
                                <span class="badge badge-success-custom" style="font-size:0.75rem;">✅ No</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(source.SourceItems?.Any() == true ? "badge-success-custom" : "")"
                                  style="font-size:0.75rem; @(source.SourceItems?.Any() != true ? "background:var(--gray-200); color:var(--gray-600);" : "")">
                                @(source.SourceItems?.Count ?? 0)
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-primary-custom btn-sm"
                                        onclick="openPreview(@source.Id, '@source.Name.Replace("'","\\'")')">
                                    📰 Ver noticias
                                </button>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@source.Id"
                                       class="btn btn-secondary-custom btn-sm">
                                        ✏️ Editar
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@source.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar esta fuente?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm"
                                                style="background:#EF4444;color:white;border:none;border-radius:var(--radius);padding:0.35rem 0.75rem;">
                                            🗑 Eliminar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- ══════════════════════════════════════════════════════════
     MODAL DE PREVIEW
     Muestra las noticias en vivo de la fuente.
     El usuario elige cuál guardar con el botón "Guardar".
     ══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header" style="background:var(--gray-50); border-bottom:1px solid var(--gray-200);">
                <div>
                    <h5 class="modal-title mb-0" id="previewModalTitle">Cargando…</h5>
                    <small class="text-muted" id="previewModalCount"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                <!-- Spinner -->
                <div id="previewSpinner" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">Conectando a la fuente…</p>
                </div>

                <!-- Error -->
                <div id="previewError" class="alert alert-danger m-3" style="display:none;"></div>

                <!-- Lista de noticias -->
                <div id="previewList" style="display:none;"></div>
            </div>

            <div class="modal-footer" style="background:var(--gray-50);">
                <small class="text-muted me-auto">
                    Hacé clic en <strong>Guardar</strong> en cualquier noticia para agregarla a la BD
                </small>
                <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let _currentSourceId = null;

async function openPreview(sourceId, sourceName) {
    _currentSourceId = sourceId;

    // Reset modal
    document.getElementById('previewModalTitle').textContent = `📰 ${sourceName}`;
    document.getElementById('previewModalCount').textContent  = '';
    document.getElementById('previewSpinner').style.display  = 'block';
    document.getElementById('previewError').style.display    = 'none';
    document.getElementById('previewList').style.display     = 'none';
    document.getElementById('previewList').innerHTML         = '';

    const modal = new bootstrap.Modal(document.getElementById('previewModal'));
    modal.show();

    try {
        const res  = await fetch(`/api/SourcesApi/${sourceId}/preview`, { credentials: 'include' });
        const data = await res.json();

        document.getElementById('previewSpinner').style.display = 'none';

        if (!res.ok) {
            document.getElementById('previewError').textContent  = data.message || 'Error al cargar';
            document.getElementById('previewError').style.display = 'block';
            return;
        }

        document.getElementById('previewModalCount').textContent =
            `${data.count} noticia(s) disponibles`;

        const list = document.getElementById('previewList');
        list.style.display = 'block';

        if (!data.items?.length) {
            list.innerHTML = '<p class="text-muted text-center py-4">No se encontraron noticias.</p>';
            return;
        }

        list.innerHTML = data.items.map((item, i) => `
            <div class="preview-item" id="item-${i}">
                <div class="preview-item-header">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <h6 class="preview-title mb-1">${escHtml(item.title || 'Sin título')}</h6>
                        <button class="btn btn-success-custom btn-sm flex-shrink-0"
                                onclick="saveItem(${i}, this)"
                                data-raw='${escAttr(item.rawJson)}'>
                            💾 Guardar
                        </button>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        ${item.author    ? `<span class="meta-author">✍️ ${escHtml(item.author)}</span>` : ''}
                        ${item.publishedAt ? `<span class="meta-date">📅 ${new Date(item.publishedAt).toLocaleDateString('es-CR',{day:'2-digit',month:'short',year:'numeric'})}</span>` : ''}
                        ${item.articleUrl ? `<a href="${escHtml(item.articleUrl)}" target="_blank" class="meta-date" style="color:var(--primary);">🔗 Ver original</a>` : ''}
                    </div>
                </div>
                <p class="preview-summary">${escHtml(item.summary || item.content?.substring(0,200) || '')}</p>
            </div>
        `).join('');

    } catch (err) {
        document.getElementById('previewSpinner').style.display  = 'none';
        document.getElementById('previewError').textContent      = `Error de conexión: ${err.message}`;
        document.getElementById('previewError').style.display    = 'block';
    }
}

async function saveItem(index, btn) {
    const rawJson = btn.getAttribute('data-raw');
    btn.disabled = true;
    btn.textContent = '⏳';

    try {
        const res  = await fetch(`/api/SourcesApi/${_currentSourceId}/save-item`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ rawJson })
        });
        const data = await res.json();

        if (res.ok || res.status === 201) {
            btn.textContent  = '✅ Guardado';
            btn.className    = 'btn btn-secondary-custom btn-sm flex-shrink-0';
            btn.disabled     = true;
        } else if (res.status === 409) {
            btn.textContent  = '⚠️ Ya existe';
            btn.disabled     = true;
        } else {
            btn.textContent  = '❌ Error';
            btn.disabled     = false;
            alert(data.message || 'Error al guardar');
        }
    } catch (err) {
        btn.textContent = '❌ Error';
        btn.disabled    = false;
    }
}

function escHtml(s) {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function escAttr(s) {
    if (!s) return '';
    return s.replace(/'/g,'&apos;').replace(/"/g,'&quot;');
}
</script>

<style>
.preview-item {
    border-bottom: 1px solid var(--gray-200);
    padding: 1.25rem 1.5rem;
    transition: background 0.15s;
}
.preview-item:last-child { border-bottom: none; }
.preview-item:hover { background: var(--gray-50); }
.preview-item-header { margin-bottom: 0.5rem; }
.preview-title {
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--gray-900);
    line-height: 1.4;
}
.preview-summary {
    font-size: 0.875rem;
    color: var(--gray-600);
    line-height: 1.6;
    margin: 0;
}
.meta-date, .meta-author {
    font-size: 0.78rem;
    color: var(--gray-600);
}
</style>
}
