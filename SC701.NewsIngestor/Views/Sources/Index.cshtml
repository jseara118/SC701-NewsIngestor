@model IEnumerable<SC701.NewsIngestor.Models.Source>

@{
    ViewData["Title"] = "Fuentes de Noticias";
}

<div class="page-header">
    <h1 class="page-title">
        📡 Fuentes de Noticias
    </h1>
    <a asp-action="Create" class="btn btn-primary-custom">
        ➕ Crear Nueva Fuente
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success-custom alert-dismissible fade show" role="alert">
        <strong>✅ ¡Éxito!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info-custom">
        <h5 class="mb-2"><strong>📭 No hay fuentes registradas</strong></h5>
        <p class="mb-0">Haz clic en "Crear Nueva Fuente" para comenzar a agregar fuentes de noticias.</p>
    </div>
}
else
{
    <div class="table-custom">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 20%;">Nombre</th>
                    <th style="width: 30%;">URL</th>
                    <th style="width: 15%;">Tipo</th>
                    <th style="width: 15%;">Secret</th>
                    <th style="width: 15%;">Descripción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="hover-lift">
                        <td><strong>#@item.Id</strong></td>
                        <td>
                            <strong style="color: var(--primary);">@item.Name</strong>
                        </td>
                        <td>
                            <a href="@item.Url" target="_blank" class="text-decoration-none"
                               style="color: var(--gray-600); font-size: 0.9rem;">
                                @(item.Url.Length > 40 ? item.Url.Substring(0, 40) + "..." : item.Url)
                                <span style="font-size: 0.8rem;">🔗</span>
                            </a>
                        </td>
                        <td>
                            <span class="badge badge-primary-custom">@item.ComponentType</span>
                        </td>
                        <td>
                            @if (item.RequiresSecret)
                            {
                                <span class="badge badge-warning-custom">🔐 Sí</span>
                            }
                            else
                            {
                                <span class="badge badge-success-custom">✅ No</span>
                            }
                        </td>
                        <td>
                            <small style="color: var(--gray-600);">
                                @(item.Description ?? "-")
                            </small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 d-flex justify-content-between align-items-center">
        <p class="text-muted mb-0">
            Total de fuentes registradas: <strong style="color: var(--primary);">@Model.Count()</strong>
        </p>
        <a asp-action="Create" class="btn btn-secondary-custom">
            ➕ Agregar Otra Fuente
        </a>
    </div>
}