@model SC701.Models.Source
@{
    ViewData["Title"] = "Editar Fuente";
    var categories = new[] { "NACIONAL", "INTERNACIONAL", "DEPORTES", "TECNOLOGÍA", "ENTRETENIMIENTO", "CIENCIA", "ECONOMÍA", "POLÍTICA", "CULTURA", "GAMING", "BUENAS NOTICIAS" };
}

<div class="page-header">
    <h1 class="page-title">✏️ Editar Fuente</h1>
    <a asp-action="Index" class="btn btn-secondary-custom">← Volver</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card-custom">
            <div class="card-header">📝 Modificar datos de la fuente</div>
            <div class="card-body">
                <form asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label-custom"></label>
                        <input asp-for="Name" class="form-control form-control-custom" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Url" class="form-label-custom"></label>
                        <input asp-for="Url" class="form-control form-control-custom" />
                        <span asp-validation-for="Url" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ComponentType" class="form-label-custom"></label>
                        <select asp-for="ComponentType" class="form-select form-select-custom" id="ComponentType">
                            <option value="">-- Seleccione un tipo --</option>
                            <option value="rss">📰 RSS</option>
                            <option value="newsapi">🗞️ NewsAPI</option>
                            <option value="html">🕷️ Web Scraper</option>
                            <option value="json">📋 JSON Feed</option>
                        </select>
                        <span asp-validation-for="ComponentType" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DefaultCategory" class="form-label-custom"></label>
                        <select asp-for="DefaultCategory" class="form-select form-select-custom">
                            <option value="">-- Sin categoría por defecto --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat" selected="@(Model.DefaultCategory == cat ? "selected" : null)">@cat</option>
                            }
                        </select>
                        <small class="text-muted">🏷️ Se aplica a noticias que no traigan categoría propia.</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label-custom"></label>
                        <textarea asp-for="Description" class="form-control form-control-custom" rows="3"></textarea>
                    </div>

                    <div class="mb-4" id="additional-urls-section">
                        <label asp-for="AdditionalUrls" class="form-label-custom"></label>
                        <textarea asp-for="AdditionalUrls" class="form-control form-control-custom" rows="5"
                                  placeholder="Una URL por línea. Ejemplo:&#10;https://sitio.com/noticia-1&#10;https://sitio.com/noticia-2"></textarea>
                        <small class="text-muted">🕷️ Solo para tipo <strong>Web Scraper</strong> — agregá una URL por línea para ingestar múltiples artículos del mismo sitio.</small>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="RequiresSecret" class="form-check-input" type="checkbox" />
                            <label asp-for="RequiresSecret" class="form-check-label form-label-custom"></label>
                        </div>
                    </div>

                    <hr class="divider" />

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary-custom">💾 Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-secondary-custom">❌ Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const typeSelect = document.getElementById('ComponentType');
        const additionalSection = document.getElementById('additional-urls-section');
        function toggleAdditionalUrls() {
            additionalSection.style.display = typeSelect.value === 'html' ? 'block' : 'none';
        }
        typeSelect.addEventListener('change', toggleAdditionalUrls);
        toggleAdditionalUrls();
    </script>
}
