@model List<SC701.Models.Secret>
@{
    ViewData["Title"] = "Secrets";
}

<div class="container mt-4">
    <div class="page-header">
        <h2 class="page-title">🔐 Secrets</h2>
        <a asp-action="Create" class="btn btn-primary">➕ Nuevo Secret</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="table-custom">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Fuente</th>
                    <th>Nombre</th>
                    <th>Valor</th>
                    <th>Descripción</th>
                    <th>Actualizado</th>
                    <th style="width: 180px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@(s.Source?.Name ?? $"Source #{s.SourceId}")</td>
                        <td><code>@s.Name</code></td>
                        <td>••••••••••</td>
                        <td>@s.Description</td>
                        <td>@s.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-primary">✏️ Edit</a>

                            <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar este secret?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">🗑 Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <small class="text-muted d-block mt-2">
        * Por seguridad, el valor del secret nunca se muestra en pantalla.
    </small>
</div>
