@model SC701.Models.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Configuración";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0">⚙️ Configuración</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h5 class="mb-0">Preferencias de la app</h5>
        </div>

        <div class="card-body p-4">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-4">

                    <!-- Idioma -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Idioma</label>

                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="Language" id="lang-es" value="es"
                                   @(Model.Language == "es" ? "checked" : "")>
                            <label class="btn btn-outline-primary rounded-start-3" for="lang-es">
                                🇨🇷 Español
                            </label>

                            <input type="radio" class="btn-check" name="Language" id="lang-en" value="en"
                                   @(Model.Language == "en" ? "checked" : "")>
                            <label class="btn btn-outline-primary rounded-end-3" for="lang-en">
                                🇺🇸 English
                            </label>
                        </div>

                        <span asp-validation-for="Language" class="text-danger"></span>
                    </div>

                    <!-- Tema -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tema</label>

                        <div class="d-flex align-items-center justify-content-between border rounded-3 px-3 py-2">

                            <span class="small text-muted">☀️ Claro</span>

                            <div class="form-check form-switch m-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="themeSwitch"
                                       @(Model.Theme == "dark" ? "checked" : "")>
                            </div>

                            <span class="small text-muted">🌙 Oscuro</span>
                        </div>

                        <input type="hidden" name="Theme" id="themeValue" value="@Model.Theme" />
                        <span asp-validation-for="Theme" class="text-danger"></span>
                    </div>

                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary px-4 rounded-3">
                            Guardar cambios
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const sw = document.getElementById('themeSwitch');
            const hidden = document.getElementById('themeValue');

            if (!sw || !hidden) return;

            function sync() {
                hidden.value = sw.checked ? 'dark' : 'light';
            }

            sw.addEventListener('change', sync);
            sync();
        })();
    </script>
}
