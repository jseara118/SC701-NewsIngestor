

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NewsIngestor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body>
    <div class="page-wrapper">
        <header>
            <nav class="navbar navbar-expand-sm navbar-custom">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span style="font-size: 1.75rem;">📰</span>
                        <span>NewsIngestor</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                                   asp-area="" asp-controller="Home" asp-action="Index">
                                    🏠 Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sources" ? "active" : "")"
                                   asp-area="" asp-controller="Sources" asp-action="Index">
                                    📡 Sources
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Items" ? "active" : "")"
                                   asp-area="" asp-controller="Items" asp-action="Index">
                                    📋 Items
                                </a>
                            </li>
                        </ul>

                        @* ✅ Auth buttons a la derecha *@
                        <ul class="navbar-nav ms-auto">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <li class="nav-item">
                                    <span class="nav-link">
                                        👤 @User.Identity!.Name
                                    </span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="nav-link btn btn-link p-0">
                                            🚪 Logout
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")"
                                       asp-controller="Account" asp-action="Login">
                                        🔐 Login
                                    </a>
                                </li>
                            }
                        </ul>

                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main role="main" class="pb-5">
                @RenderBody()
            </main>
        </div>

        <footer class="footer-custom">
            <div class="container text-center">
                <p class="mb-0">
                    <strong>SC701 NewsIngestor</strong> - Proyecto Universitario 2026
                </p>
                <small style="opacity: 0.8;">Plataforma de Agregación de Noticias</small>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
