@model SC701.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Registrarse";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card-custom">
            <div class="card-header text-center">
                <h3 class="mb-0">📝 Crear Cuenta</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label-custom"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Juan Pérez" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-custom"></label>
                        <input asp-for="Email" class="form-control" placeholder="tu@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label-custom"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <small class="text-muted">
                            Mínimo 6 caracteres, debe incluir mayúsculas, minúsculas y números
                        </small>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label-custom"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary-custom btn-lg">
                            Crear Cuenta
                        </button>
                    </div>
                </form>
                
                <hr class="my-4" />
                
                <div class="text-center">
                    <p class="mb-2">¿Ya tienes cuenta?</p>
                    <a asp-action="Login" class="btn btn-secondary-custom">
                        Iniciar Sesión
                    </a>
                </div>

                <div class="alert alert-warning mt-4 mb-0" style="font-size: 0.9rem;">
                    <strong>ℹ️ Información:</strong><br/>
                    Los nuevos usuarios se registran con rol "User" por defecto.
                    Solo el administrador puede otorgar el rol "Admin".
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
