@{
    ViewData["Title"] = "Importar Noticia (JSON)";
}

<div class="page-header">
    <h1 class="page-title">📤 Importar Noticia desde JSON</h1>
    <a asp-action="Index" class="btn btn-secondary-custom">← Volver al Listado</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Información sobre el formato -->
        <div class="card-custom mb-4" style="border-left: 4px solid var(--primary);">
            <div class="card-body">
                <h5 class="mb-3">ℹ️ Formato de Archivo Requerido</h5>
                <p class="mb-2">
                    El archivo JSON debe cumplir con el formato estándar acordado:
                    <code>edu.univ.ingest.v1</code>
                </p>
                <ul class="mb-3">
                    <li>Extensión: <code>.json</code></li>
                    <li>Tamaño máximo: <strong>10 MB</strong></li>
                    <li>Schema Version: <code>"edu.univ.ingest.v1"</code></li>
                    <li>Debe incluir secciones: <code>source</code>, <code>normalized</code></li>
                </ul>
                <div class="alert alert-info py-2 mb-2" style="font-size:0.88rem;">
                    💡 <strong>Modo flexible:</strong> Si el JSON tiene campos incompletos (como <code>content</code> vacío o <code>publishedAt</code> nulo),
                    el sistema intenta rellenarlos automáticamente desde el bloque <code>raw</code> y te avisa qué se completó.
                </div>
                <details>
                    <summary style="cursor: pointer; color: var(--primary); font-weight: 500;">
                        📝 Ver ejemplo de formato válido
                    </summary>
                    <pre class="mt-3 p-3" style="background: #1E293B; color: #E2E8F0; border-radius: var(--radius); font-size: 0.85rem; overflow-x: auto;"><code>{
                        "schemaVersion": "edu.univ.ingest.v1",
                        "exportedAt": "2026-02-13T15:00:00Z",
                        "source": {
                        "name": "New York Times",
                        "type": "api",
                        "url": "https://api.nytimes.com/...",
                        "requiresSecret": true
                        },
                        "normalized": {
                        "title": "Título de la noticia",
                        "content": "Contenido completo...",
                        "publishedAt": "2026-02-13T08:00:00Z"
                        },
                        "raw": {
                        "format": "json"
                        }
                        }</code></pre>
                    </details>
                </div>
            </div>

            <!-- Formulario de Upload -->
            <div class="card-custom">
                <div class="card-header">📁 Seleccionar Archivo JSON</div>
                <div class="card-body">
                    <form id="uploadForm" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label for="fileInput" class="form-label-custom">Archivo JSON:</label>
                            <input type="file" class="form-control" id="fileInput" name="file" accept=".json" required>
                            <small class="text-muted mt-2 d-block">Solo archivos .json (máximo 10 MB)</small>
                        </div>

                        <!-- Área de resultado -->
                        <div id="resultArea" class="mb-3" style="display: none;"></div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-secondary-custom">Cancelar</a>
                            <button type="submit" class="btn btn-primary-custom" id="uploadBtn">
                                📤 Importar Noticia
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Mensajes de ayuda -->
            <div class="mt-4">
                <div class="card-custom" style="background: var(--gray-50); border: 1px dashed var(--gray-300);">
                    <div class="card-body">
                        <h6 class="mb-2">💡 ¿Qué pasa al importar?</h6>
                        <ol class="mb-0" style="color: var(--gray-700);">
                            <li>El sistema valida que el JSON tenga la estructura mínima requerida</li>
                            <li>Campos incompletos (<code>content</code>, <code>publishedAt</code>, <code>summary</code>) se rellenan automáticamente</li>
                            <li>Si la fuente (<code>source.url</code>) no existe, se crea automáticamente</li>
                            <li>Se guarda el item completo en la base de datos</li>
                            <li>Recibirás un aviso de qué campos fueron completados automáticamente</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.getElementById('uploadForm').addEventListener('submit', async function(e) {
                e.preventDefault();

                const fileInput = document.getElementById('fileInput');
                const uploadBtn = document.getElementById('uploadBtn');

                if (!fileInput.files || fileInput.files.length === 0) {
                    showResult('error', '❌ Por favor seleccioná un archivo');
                    return;
                }

                const file = fileInput.files[0];

                if (!file.name.endsWith('.json')) {
                    showResult('error', '❌ El archivo debe tener extensión .json');
                    return;
                }

                if (file.size > 10 * 1024 * 1024) {
                    showResult('error', '❌ El archivo excede el tamaño máximo de 10 MB');
                    return;
                }

                const formData = new FormData();
                formData.append('file', file);

                uploadBtn.disabled = true;
                uploadBtn.innerHTML = '⏳ Importando...';

                try {
                    const response = await fetch('/api/NewsInterop/import', {
                        method: 'POST',
                        body: formData,
                        credentials: 'include'
                    });

                    const result = await response.json();

                    if (response.ok) {
                        const hasWarnings = result.warnings && result.warnings.length > 0;

                        // Bloque de advertencias si hubo campos rellenados
                        let warningsHtml = '';
                        if (hasWarnings) {
                            warningsHtml = `
                                <div class="alert alert-warning mt-3 mb-0 py-2">
                                    <strong>⚠️ Campos rellenados automáticamente:</strong>
                                    <ul class="mb-0 mt-1">
                                        ${result.warnings.map(w => `<li style="font-size:0.88rem;">${w}</li>`).join('')}
                                    </ul>
                                </div>`;
                        }

                        showResult(hasWarnings ? 'warning' : 'success', `
                            <strong>${hasWarnings ? '✅ Noticia importada con campos incompletos' : '✅ Noticia importada exitosamente'}</strong>
                            <div class="mt-2" style="font-size:0.9rem;">
                                <div><strong>ID:</strong> ${result.id}</div>
                                <div><strong>Fuente:</strong> ${result.sourceName}</div>
                                <div><strong>Título:</strong> ${result.title}</div>
                            </div>
                            ${warningsHtml}
                            <div class="mt-3 d-flex gap-2">
                                <a href="/Items" class="btn btn-primary-custom btn-sm">📋 Ver Todos los Items</a>
                            </div>
                        `);

                        fileInput.value = '';

                    } else {
                        let errorMessage = `❌ ${result.message || 'Error al importar el archivo'}`;

                        if (result.errors && Array.isArray(result.errors)) {
                            errorMessage += '<ul class="mt-2 mb-0">';
                            result.errors.forEach(err => { errorMessage += `<li>${err}</li>`; });
                            errorMessage += '</ul>';
                        }

                        showResult('error', errorMessage);
                    }

                } catch (error) {
                    console.error('Error:', error);
                    showResult('error', '❌ Error de conexión. Por favor intentá nuevamente.');
                } finally {
                    uploadBtn.disabled = false;
                    uploadBtn.innerHTML = '📤 Importar Noticia';
                }
            });

            function showResult(type, message) {
                const resultArea = document.getElementById('resultArea');
                const alertClass = type === 'success' ? 'alert-success'
                                 : type === 'warning' ? 'alert-warning'
                                 : 'alert-danger';

                resultArea.innerHTML = `<div class="alert ${alertClass} mb-0">${message}</div>`;
                resultArea.style.display = 'block';
                resultArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        </script>
    }

